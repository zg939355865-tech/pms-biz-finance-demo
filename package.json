{
  "name": "pms-bizfin-static-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "site:prepare": "node scripts/hosting/prepare-site-assets.mjs",
    "prebuild": "npm run site:prepare",
    "build": "vinext build",
    "dev": "npm run site:prepare && vinext dev",
    "start": "vinext start",
    "page:build": "node scripts/generate/page-from-schema.mjs",
    "generate:page": "node scripts/generate/page-from-schema.mjs",
    "prototype:build": "node scripts/generate/prototype-from-schema.mjs",
    "generate:menu": "node scripts/generate/menu-from-excel.mjs",
    "resource:center": "node scripts/generate/resource-center.mjs",
    "check:schema": "node scripts/check/schema-check.mjs",
    "check:policy": "node scripts/check/policy-check.mjs",
    "check:page": "node scripts/check/page-check.mjs",
    "check:visual": "node scripts/check/schema-page-smoke.mjs",
    "check:business-lists": "node scripts/check/business-list-standard-smoke.mjs",
    "check:create-details": "node scripts/check/create-detail-standard-smoke.mjs",
    "check:project-setup-stage": "node scripts/check/project-setup-stage-smoke.mjs",
    "check:project-plan-basic-info": "node scripts/check/project-plan-basic-info-smoke.mjs",
    "check:all-pages": "node scripts/check/all-pages-desktop-check.mjs",
    "check:components": "node scripts/check/component-coverage-check.mjs",
    "check:resource": "node scripts/check/resource-center-check.mjs",
    "check:resource-visual": "node scripts/check/resource-center-smoke.mjs",
    "report:summary": "node scripts/check/report-summary.mjs",
    "menu:update": "npm run generate:menu -- inputs/excel/menu/menu-simple.xlsx menu/index.html",
    "prototype:income-contract": "npm run prototype:build -- schemas/pages/income/income-contract-schema.json && npm run check:visual -- pages/income/income-contract-schema.html",
    "prototype:all": "npm run resource:center && npm run check:resource && npm run check:resource-visual && npm run check:components && npm run prototype:income-contract && npm run menu:update",
    "harness:check": "node scripts/check/harness-check.mjs"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.27",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.2.0"
  }
}
