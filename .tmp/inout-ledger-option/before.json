  "rules": [
    { "id": "R01", "description": "仅来源单据审核成功后按具体业务行生成流水，来源单据状态不是已审核时不生成。" },
    { "id": "R02", "description": "采购入库蓝字、物资出库红字、盘盈入库、期初补录、其他入库为正数；采购入库红字、物资出库蓝字、盘亏出库、报废出库、其他出库为负数。" },
    { "id": "R03", "description": "当时剩余数量等于审核前同采购类别、采购名称、规格、库位、库存地点余量加本流水带符号移动数量。" },
    { "id": "R04", "description": "同一来源单据的不同行号生成不同且系统级递增的流水号，流水号不回收、不复用。" },
    { "id": "R05", "description": "流水为审核时快照，后续主数据变化不回写历史流水。" },
    { "id": "R06", "description": "仅采购入库-蓝字、采购入库-红字取采购入库单供应商；其余移动业务供应商统一显示为—。" }
  ],
  "relations": [
    { "from": "已审核采购入库行", "to": "出入库流水", "type": "入库事实", "description": "蓝字增加库存，红字减少库存。" },
    { "from": "已审核物资出库行", "to": "出入库流水", "type": "领用与退回事实", "description": "蓝字减少库存，红字增加库存。" },
    { "from": "已审核其他出库行", "to": "出入库流水", "type": "库存调整出库", "description": "盘亏、报废和其他出库减少库存。" },
    { "from": "已审核其他入库行", "to": "出入库流水", "type": "库存调整入库", "description": "盘盈、期初补录和其他入库增加库存。" }
  ],
  "uiConstraints": { "listPageSize": 5 }
}
