        { "code": "checkItem", "label": "检查事项", "component": "input", "editable": true, "required": true, "width": 220 },
        { "code": "sqlScript", "label": "执行SQL脚本", "component": "input", "editable": true, "required": true, "width": 250 },
        { "code": "checkTime", "label": "检查时间", "component": "datetime", "editable": false, "width": 180 },
        { "code": "checkResult", "label": "检查结果", "component": "tag", "editable": false, "align": "center", "width": 120 },
        { "code": "affectsClosing", "label": "影响结账？", "component": "tag", "editable": false, "align": "center", "width": 120 },
        { "code": "configuredBy", "label": "配置人", "component": "text", "editable": false, "width": 120 }
      ],
      "rows": [
        { "id": "CFG01", "checkModule": "物资", "checkItem": "物资出入库单审核完成性", "sqlScript": "CLOSE_MATERIAL_DOCUMENT_CHECK", "checkTime": "2026-09-03 10:20:33", "checkResult": "未通过", "affectsClosing": "是", "configuredBy": "财务-李婷" },
        { "id": "CFG02", "checkModule": "收入", "checkItem": "收入确认单审核完成性", "sqlScript": "CLOSE_INCOME_RECOGNITION_CHECK", "checkTime": "2026-09-03 10:20:34", "checkResult": "未通过", "affectsClosing": "是", "configuredBy": "财务-李婷" },
        { "id": "CFG03", "checkModule": "采购", "checkItem": "采购订单、入库及收票完成性", "sqlScript": "CLOSE_PURCHASE_DOCUMENT_CHECK", "checkTime": "2026-09-03 10:20:36", "checkResult": "未通过", "affectsClosing": "是", "configuredBy": "财务-李婷" }
      ]
    },
    {
      "id": "unfinished-documents",
      "component": "Space",
