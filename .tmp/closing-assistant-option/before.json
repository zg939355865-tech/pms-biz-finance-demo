        "accountingYear": "2026",
        "accountingPeriod": "9",
        "dateRange": "2026-09-01 至 2026-09-30",
        "checker": "财务-李婷"
      },
      "fields": [
        { "code": "company", "label": "核算主体" },
        { "code": "accountingYear", "label": "年度" },
        { "code": "accountingPeriod", "label": "会计期间" },
        { "code": "dateRange", "label": "期间范围" },
        { "code": "checker", "label": "检查人" }
      ]
    },
    {
      "id": "closing-check-config-table",
      "component": "EditableTable",
      "title": "结账检查配置",
      "pageSize": 5,
      "pagination": false,
      "showPageSize": true,
      "selectable": false,
      "inlineEditMode": true,
      "headerActions": true,
      "operationColumnWidth": 144,
      "actions": [
        { "code": "add-row", "label": "新增配置", "type": "primary", "icon": "fa-plus" }
