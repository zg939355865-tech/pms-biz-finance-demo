  "pageType": "dashboard",
  "template": "workbench-page",
  "outputPath": "pages/period-close/closing-assistant.html",
  "businessScenario": "围绕当前已启动会计期间，集中检查物资、收入、采购单据完成情况，定位未完成单据及责任人并持续复检直至全部通过。",
  "workflowActions": false,
  "toastEnabled": false,
  "resourceReference": {
    "center": "prototype-resources/index.html",
    "baseline": "pms-resource-center-v1",
    "pageSamples": ["工作台页", "标准列表页", "结果页"],
    "components": ["PageHeader", "Space", "Descriptions", "ProTable", "Tag", "ProResult", "ProDetailDrawer", "ProDescriptionList", "Alert"]
  },
  "uiConstraints": {
    "noPageSizeSelector": true,
    "desktopOnly": true,
    "noBusinessPageVerticalScroll": true
  },
  "periodCloseConfig": {
    "mode": "closing-assistant",
    "activeAccountingPeriod": "202609",
    "activeAccountingYear": "2026",
    "activeAccountingMonth": "9",
    "rangeBoundary": "inclusive",
    "businessDomains": ["物资", "收入", "采购"],
    "checkAction": "run-closing-check",
    "passStatus": "全部通过",
    "blockingStatus": "未通过",
    "invalidateOnSourceChange": true
  },
  "pageActions": [
    {
      "code": "run-closing-check",
      "label": "开始检查",
      "type": "primary",
      "icon": "fa-play"
    }
  ],
