{
  "schemaVersion": "pms-page-schema-v2",
  "policyProfile": "utility-page",
  "policyVersion": "pms-policy-v1",
  "domain": "report",
  "module": "报表管理",
  "pageType": "dashboard",
  "workflowActions": false,
  "toastEnabled": false,
  "pageCode": "project-lifecycle-dashboard",
  "pageName": "项目全生命周期驾驶舱",
  "menuPath": "首页",
  "template": "dashboard-page",
  "outputPath": "pages/report/project-lifecycle-dashboard.html",
  "businessScenario": "面向管理层、PMO和项目经理，查看从项目需求到运营维护的阶段分布、执行进度和客观异常。",
  "resourceReference": {
    "center": "prototype-resources/index.html",
    "baseline": "pms-resource-center-v1",
    "pageSamples": ["数据看板页", "标准列表页"],
    "components": ["PageHeader", "ProSearchForm", "ProStatCard", "Space", "ProChartCard", "ProTable", "Tag"]
  },
  "uiConstraints": {
    "desktopOnly": true,
    "noPageSizeSelector": true,
    "noBusinessPageVerticalScroll": true
  },
  "pageActions": [],
  "metricDefinitions": [
    { "code": "pendingSetupCount", "label": "待立项事项", "source": "项需求/调研问卷/项目方案/实施通知", "formula": "按业务链路去重，且未形成已审核项目立项记录" },
    { "code": "setupProjectCount", "label": "已立项项目", "source": "项目立项", "formula": "已审核项目按项目编码去重" },
    { "code": "activeProjectCount", "label": "进行中项目", "source": "项目计划/项目进度", "formula": "项目状态=进行中，且未进入验收或运营维护" },
    { "code": "acceptancePendingCount", "label": "待验收项目", "source": "项目阶段/验收资料", "formula": "已进入验收且未完成验收" },
    { "code": "operationsProjectCount", "label": "运营维护项目", "source": "验收结果/项目运维记录", "formula": "验收完成并进入运营维护的项目数" },
    { "code": "overdueProjectCount", "label": "延期项目", "source": "项目计划", "formula": "当前日期>计划完成日期且实际完成日期为空" },
    { "code": "staleProgressCount", "label": "超过7天未填报", "source": "项目进度", "formula": "进行中项目的最近有效进度日期距当前日期>7天" },
    { "code": "overdueOpenIssueCount", "label": "超期未解决问题", "source": "项目运维记录", "formula": "实际解决日期为空且当前日期>解决截止日期" }
  ],
  "regions": [
    {
      "id": "project-lifecycle-search",
      "component": "ProSearchForm",
      "queryPrimary": true,
      "fields": [
        { "code": "statisticsDate", "label": "统计日期", "component": "date-range", "filterCodes": ["latestBusinessDate"] },
        { "code": "projectKeyword", "label": "项目或需求", "component": "input", "placeholder": "编码/名称", "filterCodes": ["lifecycleCode", "subjectName"] },
        { "code": "lifecycleStage", "label": "生命周期阶段", "component": "select", "options": ["需求", "调研", "方案", "实施通知", "立项", "计划", "执行", "验收", "运营维护"] },
        { "code": "projectStatus", "label": "项目状态", "component": "select", "options": ["待立项", "未开始", "进行中", "待验收", "运营维护"] },
        { "code": "projectManager", "label": "项目负责人", "component": "input" },
        { "code": "projectType", "label": "项目类型", "component": "select", "options": ["工艺智控", "智能化改造", "软件实施", "技术服务"] },
        { "code": "company", "label": "项目主责公司", "component": "select", "options": ["昕彤赋能（长沙）人工智能行业应用系统有限公司", "昕彤赋能（武汉）设计研究有限公司"] },
        { "code": "region", "label": "区域", "component": "select", "options": ["河北省", "湖北省", "湖南省", "浙江省", "广东省", "江苏省"] }
      ]
    },
    {
      "id": "project-lifecycle-stats",
      "component": "ProStatCard",
      "statColumns": 8,
      "items": [
        { "label": "待立项事项", "value": 12, "meta": "需求至实施通知", "tone": "info" },
        { "label": "已立项项目", "value": 24, "meta": "已审核去重", "tone": "info" },
        { "label": "进行中项目", "value": 11, "meta": "计划和执行阶段", "tone": "success" },
        { "label": "待验收项目", "value": 4, "meta": "已进入验收", "tone": "warning" },
        { "label": "运营维护项目", "value": 5, "meta": "覆盖全部项目", "tone": "success" },
        { "label": "延期项目", "value": 5, "meta": "未完成且超计划日期", "tone": "danger" },
        { "label": "超过7天未填报", "value": 4, "meta": "进行中项目", "tone": "warning" },
        { "label": "超期未解决问题", "value": 2, "meta": "项目运维记录", "tone": "danger" }
      ]
    },
    {
      "id": "project-lifecycle-charts",
      "component": "Space",
      "children": [
        {
          "id": "lifecycle-stage-chart",
          "component": "ProChartCard",
          "title": "生命周期阶段分布",
          "chartType": "bar",
          "valueUnit": "个",
          "filterField": "lifecycleStage",
          "data": [
            { "label": "需求", "value": 4, "color": "#1677ff" },
            { "label": "调研", "value": 3, "color": "#4096ff" },
            { "label": "方案", "value": 3, "color": "#597ef7" },
            { "label": "实施通知", "value": 2, "color": "#36cfc9" },
            { "label": "立项", "value": 4, "color": "#13c2c2" },
            { "label": "计划", "value": 4, "color": "#52c41a" },
            { "label": "执行", "value": 7, "color": "#73d13d" },
            { "label": "验收", "value": 4, "color": "#faad14" },
            { "label": "运营维护", "value": 5, "color": "#722ed1" }
          ]
        },
        {
          "id": "project-status-chart",
          "component": "ProChartCard",
          "title": "已立项项目状态分布",
          "chartType": "donut",
          "valueUnit": "个",
          "centerLabel": "已立项项目",
          "filterField": "projectStatus",
          "data": [
            { "label": "未开始", "value": 4, "color": "#8c8c8c" },
            { "label": "进行中", "value": 11, "color": "#1677ff" },
            { "label": "待验收", "value": 4, "color": "#faad14" },
            { "label": "运营维护", "value": 5, "color": "#52c41a" }
          ]
        }
      ]
    },
    {
      "id": "project-lifecycle-table",
      "component": "ProTable",
      "title": "项目全生命周期明细",
      "subtitle": "延期、未更新、缺失文档和未解决问题均按原始业务记录直接计算。",
      "pageSize": 5,
      "showRecordCount": true,
      "showPageSize": true,
      "selectable": false,
      "headerActions": false,
      "keepOperationColumn": false,
      "rowActions": [],
      "minWidth": 1544,
      "columns": [
        {
          "code": "lifecycleCode",
          "label": "生命周期编号",
          "component": "text",
          "fixed": "left",
          "fixedOffset": 0,
          "width": 184,
          "navigationByFieldValue": {
            "field": "sourcePage",
            "values": {
              "项目需求": { "path": "project-requirement.html", "moduleName": "项目前期", "pageName": "项目需求", "fixedQuery": { "sample": "detail", "recordField": "requirementNo" }, "queryMap": { "recordValue": "lifecycleCode" } },
              "调研问卷": { "path": "survey-questionnaire.html", "moduleName": "项目前期", "pageName": "调研问卷", "fixedQuery": { "sample": "detail", "recordField": "questionnaireId" }, "queryMap": { "recordValue": "lifecycleCode" } },
              "项目方案": { "path": "project-proposal.html", "moduleName": "项目前期", "pageName": "项目方案", "fixedQuery": { "sample": "detail", "recordField": "proposalNo" }, "queryMap": { "recordValue": "lifecycleCode" } },
              "项目实施通知": { "path": "project-notice.html", "moduleName": "项目前期", "pageName": "项目实施通知", "fixedQuery": { "sample": "detail", "recordField": "noticeNo" }, "queryMap": { "recordValue": "lifecycleCode" } },
              "项目立项": { "path": "project-setup.html", "moduleName": "项目管理", "pageName": "项目立项", "fixedQuery": { "sample": "detail", "recordField": "projectCode" }, "queryMap": { "recordValue": "projectCode" } }
            }
          }
        },
        { "code": "subjectName", "label": "项目/需求名称", "component": "text", "width": 220 },
        { "code": "lifecycleStage", "label": "生命周期阶段", "component": "tag", "align": "center", "width": 120 },
        { "code": "projectStatus", "label": "项目状态", "component": "tag", "align": "center", "width": 112 },
        { "code": "projectManager", "label": "项目负责人", "component": "text", "width": 120 },
        { "code": "plannedFinishDate", "label": "计划完成日期", "component": "date", "width": 136 },
        { "code": "cumulativeProgress", "label": "累计进度(%)", "component": "number", "align": "right", "width": 120 },
        { "code": "overdueDays", "label": "延期天数", "component": "number", "align": "right", "width": 104 },
        { "code": "daysSinceLastUpdate", "label": "未更新天数", "component": "number", "align": "right", "width": 120 },
        { "code": "missingDeliverables", "label": "缺失必交文档", "component": "number", "align": "right", "width": 136 },
        { "code": "openIssues", "label": "未解决问题", "component": "number", "align": "right", "width": 120 }
      ],
