  "interactions": [
    {
      "trigger": "supplier.select",
      "effect": "未选择供应商时收款账户无可选数据且不可下拉，收款银行为空；选择供应商后带出供应商名称、结算币别、统一社会信用代码，加载该供应商的收款账户并默认首个账户，收款银行按默认账户自动带出；结算币别缺失时默认 CNY。"
    },
    {
      "trigger": "payeeAccount.change",
      "effect": "在当前供应商的收款账户中重新选择后，自动带出对应收款银行。"
    },
    {
      "trigger": "quantity_or_unitPrice.input",
      "effect": "按数量乘以含税单价实时计算明细金额，并将全部明细金额自动汇总到合同总金额。"
    },
    {
      "trigger": "submit.click",
      "effect": "校验合同编号、合同名称、供应商、合同负责人、日期、付款方式和发票类型等必填字段；无明细时校验至少一个附件；校验通过后保存合同，状态置为审核并返回列表，不创建审批流程实例。"
    },
    {
      "trigger": "purchaseOrder.reference",
      "effect": "采购订单引用后锁定合同核心字段和全部标的明细，仍可维护负责人、备注并追加附件。"
    },
    {
      "trigger": "audit.click",
      "effect": "列表单选状态为新增的合同后审核，状态变为审核，记录审核人和审核时间。"
    },
    {
      "trigger": "reverseAudit.click",
      "effect": "列表单选审核合同后反审核，状态回到新增，清空审核人和审核时间。"
    },
    {
      "trigger": "close-contract.click",
      "effect": "列表单选业务状态为履约中的合同后关闭，业务状态变为已关闭。"
    }
  ],
  "rules": [
    {
      "id": "R01",
      "description": "支出合同不创建审批流程；仅状态为新增的合同可审核，审核后状态为审核并记录审核人和审核时间；审核可反审核回到新增；提交后状态置为审核；合同状态为只读信息。"
    },
    {
      "id": "R02",
      "description": "支出合同不直接关联项目；采购订单负责关联项目，并可选关联合同。"
    },
    {
      "id": "R03",
      "description": "未选择供应商时收款账户下拉禁用且无可选数据，收款银行为空；选择供应商后加载该供应商账户并默认首个账户，允许重新选择，收款银行随账户自动带出并只读。"
    },
    {
      "id": "R04",
      "description": "合同编号由用户手工录入；新增时必填，不由系统自动生成。"
    },
    {
      "id": "R05",
      "description": "合同总金额只读，按全部标的明细行金额自动汇总；明细金额等于数量乘以含税单价。"
    },
    {
      "id": "R06",
      "description": "合同标的明细选填；无明细时至少上传一份合同附件。"
    },
    {
      "id": "R07",
      "description": "基础信息与标的明细位于同一基础信息页签，合同附件保留独立页签。"
    },
    {
      "id": "R08",
      "description": "合同被采购订单引用后不可删除，供应商、合同日期和标的明细不可修改。"
    },
    {
      "id": "R09",
      "description": "合同被引用后仍可维护合同负责人、备注和补充附件，已上传附件不得删除。"
