  "module": "收入管理",
  "menuPath": "收入管理/收入合同",
  "pageType": "list-detail",
  "template": "tabs-detail-page",
  "outputPath": "pages/income/income-contract-schema.html",
  "businessScenario": "收入合同基础信息、服务明细、收款计划、附件及项目结算关联信息的统一维护；不发起审批流程。",
