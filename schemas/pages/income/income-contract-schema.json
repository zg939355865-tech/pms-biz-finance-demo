  "interactions": [
    {
      "trigger": "customer.select",
      "effect": "单选客户后回填客户编码、客户名称、默认联系人、联系电话、销售负责人和结算币别；联系人可在该客户联系人范围内下拉调整。"
    },
    {
      "trigger": "customerContact.change",
      "effect": "根据所选客户联系人自动带出联系电话。"
    },
    {
      "trigger": "contractLevel.change",
      "effect": "主合同字段始终显示；合同层级为主合同时置灰不可编辑，子合同时可选且必填。"
    },
    {
      "trigger": "serviceDetail.change",
      "effect": "价税合计、税额、不含税金额和不含税单价按数量、含税单价和税率计算；合同总金额汇总服务明细价税合计。"
    },
    {
      "trigger": "projectSettlement.callback",
      "effect": "项目结算单自动回传项目所属公司、项目编号、项目名称、项目经理和归集金额至关联信息；不允许在收入合同手工选择项目。"
    },
    {
      "trigger": "submit.click",
      "effect": "校验基础必填项及子合同主合同；保存业务数据并返回列表，不发起审批流程。"
    },
    {
      "trigger": "audit.click",
      "effect": "列表单选新增状态合同后审核，状态变为审核，记录审核人和审核时间。"
    },
