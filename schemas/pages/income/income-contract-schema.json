  "pageActions": [
    {
      "code": "audit",
      "label": "审核",
      "type": "primary",
      "requiresSingleSelection": true,
      "enabledSelectionStatuses": [
        "新增"
      ],
      "nextStatus": "审核",
      "fieldUpdates": {
        "reviewer": "管理员",
        "reviewedAt": "$currentDateTime"
      }
    },
    {
      "code": "reverse-audit",
      "label": "反审核",
      "requiresSingleSelection": true,
      "enabledSelectionStatuses": [
        "审核"
      ],
      "enabledSelectionWhen": {
        "businessStatus": [
          "未生效",
          "已生效"
        ]
      },
      "nextStatus": "新增",
      "fieldUpdates": {
        "reviewer": "",
        "reviewedAt": ""
      }
    },
    {
      "code": "close-contract",
      "label": "关闭",
      "type": "danger",
      "ghost": true,
      "requiresSingleSelection": true,
      "enabledSelectionWhen": {
        "businessStatus": "履约中"
      },
      "rowFieldUpdate": true,
      "fieldUpdates": {
        "businessStatus": "已关闭"
      }
    },
    {
      "code": "batch-delete",
      "label": "批量删除",
      "type": "danger",
      "ghost": true,
      "requiresSelection": true
    },
    {
      "code": "create",
      "label": "新增",
      "type": "primary",
      "target": "contract-form"
    }
  ],
