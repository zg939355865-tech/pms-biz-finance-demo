          "label": "基础信息",
          "children": [
            {
              "id": "variance-basic-form",
              "component": "DetailForm",
              "showTitle": false,
              "layoutColumns": 3,
              "fields": [
                {
                  "code": "invoiceNo",
                  "label": "发票号码",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "status",
                  "label": "状态",
                  "component": "select",
                  "readonly": true,
                  "preserveOnCreate": true,
                  "value": "审核",
                  "options": [
                    "新增",
                    "审核"
                  ]
                },
                {
                  "code": "varianceAdjustmentDate",
                  "label": "调整日期",
                  "component": "date",
                  "readonly": true,
                  "defaultToday": true,
                  "preserveOnCreate": true,
                  "value": "2026-09-03"
                },
                {
                  "code": "purchaseCategory",
                  "label": "物资类型",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "purchaseName",
                  "label": "物资名称",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "specification",
                  "label": "规格",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "unit",
                  "label": "单位",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "verificationQuantity",
                  "label": "验票数量",
                  "component": "number",
                  "readonly": true,
                  "precision": 2
                },
                {
                  "code": "estimatedUnitPrice",
                  "label": "暂估单价",
                  "component": "number",
                  "readonly": true,
                  "precision": 2
                },
                {
                  "code": "taxIncludedUnitPrice",
                  "label": "含税单价",
                  "component": "number",
                  "readonly": true,
                  "precision": 2
                },
                {
                  "code": "unitPriceDifference",
                  "label": "单位价差",
                  "component": "number",
                  "readonly": true,
                  "precision": 2,
                  "calculatedBy": {
                    "type": "difference",
                    "minuendField": "taxIncludedUnitPrice",
                    "subtrahendField": "estimatedUnitPrice",
                    "precision": 2,
                    "recalculateOn": [
                      "taxIncludedUnitPrice",
                      "estimatedUnitPrice"
                    ]
                  }
                },
                {
                  "code": "costPriceDifference",
                  "label": "调整成本",
                  "component": "number",
                  "readonly": true,
                  "precision": 2,
                  "calculatedBy": {
                    "type": "multiply",
                    "fields": [
                      "unitPriceDifference",
                      "verificationQuantity"
                    ],
                    "precision": 2,
                    "recalculateOn": [
                      "unitPriceDifference",
                      "verificationQuantity"
                    ]
                  }
                },
                {
                  "code": "adjustDirection",
                  "label": "成本调整方向",
                  "component": "input",
                  "readonly": true,
                  "description": "采购入库单有值时显示'计入当月月末加权平均'；服务结算单有值时显示'计入当月成本'"
                },
                {
                  "code": "purchaseOrderNo",
                  "label": "采购订单",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "purchaseOrderLine",
                  "label": "订单行",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "purchaseReceiptNo",
                  "label": "采购入库单（蓝字）",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "purchaseReceiptLine",
                  "label": "入库行",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "serviceSettlementNo",
                  "label": "服务结算单（蓝字）",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "serviceSettlementLine",
                  "label": "结算行",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "creator",
                  "label": "创建人",
                  "component": "input",
                  "readonly": true,
                  "preserveOnCreate": true,
                  "value": "李婷"
                },
                {
                  "code": "createdAt",
                  "label": "创建时间",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "auditor",
                  "label": "审核人",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "auditedAt",
                  "label": "审核时间",
                  "component": "input",
                  "readonly": true
                },
                {
                  "code": "company",
                  "label": "所属公司",
                  "component": "select",
                  "readonly": true,
                  "preserveOnCreate": true,
                  "value": "昕彤赋能（武汉）设计研究有限公司",
                  "options": [
                    "昕彤赋能（武汉）设计研究有限公司"
                  ]
                },
                {
                  "code": "remark",
                  "label": "备注",
                  "component": "input",
                  "placeholder": "请输入备注，最多500字"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
